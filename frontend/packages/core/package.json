{
  "name": "@vtrs/core",
  "version": "1.0.0",
  "private": true,
  "description": "Typed API client, submission hashing, copy and status vocabulary for the VTRS web app",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./schema": "./src/api/schema.d.ts"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../../../docs/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
