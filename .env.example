# Copy to .env for local overrides. Development placeholders only; never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only

# The app connects as vtrs_app (DML only); migrations run as vtrs_migrator.
DATABASE_URL=postgres://vtrs_app:vtrs_app_dev@localhost:5432/vtrs
MIGRATE_DATABASE_URL=postgres://vtrs_migrator:vtrs_migrator_dev@localhost:5432/vtrs
# Tests create their own database, so they need a role with CREATEDB.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6380/0
REDIS_CHANNELS_URL=redis://localhost:6381/0

LOG_LEVEL=INFO
